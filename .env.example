# Free-tier Gemini API. Set as a server-only Vercel environment variable.
# Never use a VITE_ prefix for this key and never put it in the APK or frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Set this build variable in GitHub Actions repository Variables for Android APK builds.
VITE_API_BASE_URL=https://your-project.vercel.app

# Supabase public project settings (server-side overrides; never use a service-role key).
SUPABASE_URL=
SUPABASE_ANON_KEY=
