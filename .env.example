# SHER AI uses Gemini for server-side chat and app generation.
# Add this secret in Vercel Project Settings -> Environment Variables.
# Never commit the real key to GitHub or put it in frontend code.
GEMINI_API_KEY=

# Supabase public project settings are used for Gmail/password sign-in.
# These are publishable/public values, not service-role secrets.
SUPABASE_URL=
SUPABASE_ANON_KEY=
