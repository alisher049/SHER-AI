# Server-side Google Gemini key. Add the real value only in Vercel Environment Variables.
# Do not prefix this with VITE_ and never commit the real key.
GEMINI_API_KEY=
# Optional: use a model enabled for your Google AI Studio project.
GEMINI_MODEL=gemini-2.5-flash

# Supabase public project settings used for Gmail/password sign-in.
SUPABASE_URL=
SUPABASE_ANON_KEY=
